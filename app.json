{
  "expo": {
    "name": "DengueTrace",
    "slug": "denguetrace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "denguetrace",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.denguetrace.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.denguetrace.app",
      "config": { "googleMaps": {} },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": { "output": "server", "favicon": "./assets/images/favicon.png" },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "backgroundColor": "#208AEF", "image": "./assets/images/splash-icon.png", "imageWidth": 76 }],
      "expo-secure-store",
      ["expo-location", { "locationWhenInUsePermission": "DengueTrace usa tu ubicación solo cuando lo solicitas para adjuntarla a tu reporte." }],
      ["expo-sensors", { "motionPermission": "DengueTrace solicita acceso al acelerómetro para mostrar las lecturas de movimiento del teléfono." }],
      "expo-notifications",
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }]
    ],
    "experiments": { "typedRoutes": true, "reactCompiler": true },
    "extra": {
      "router": { "asyncRoutes": { "web": true } },
      "eas": { "projectId": "8dbbdd1f-541a-4b52-bb7f-dc12d88a8205" }
    },
    "owner": "marcoruizc",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": { "url": "https://u.expo.dev/8dbbdd1f-541a-4b52-bb7f-dc12d88a8205" }
  }
}
